<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Remotes -->
  <remote name="github"
          fetch=".." />
  <remote name="aosp"
          fetch="https://android.googlesource.com" />

  <!-- Default settings: lineage-22.2 kernel branch on GitHub -->

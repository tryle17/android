           remote="github"
           sync-c="true"
           sync-j="4" />

  <!-- Kernel configuration repository -->
  <project path="kernel/configs"
           name="LineageOS/android_kernel_configs"
           groups="vts,pdk" />

  <!-- Device-specific kernel and related code -->
  <include name="snippets/sm8750.xml" />
</manifest>
